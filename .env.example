# Every variable is optional — the stack runs end-to-end with none of them set.
# Copy to `.env` and uncomment what you need.

# --- Feedback provider -------------------------------------------------------
# auto (default): first configured of anthropic / openai / ollama, else the
# built-in deterministic templates. Or pin one explicitly.
#CODEGUIDE_FEEDBACK_PROVIDER=auto

# Anthropic (https://console.anthropic.com)
#ANTHROPIC_API_KEY=
#CODEGUIDE_ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI
#OPENAI_API_KEY=
#CODEGUIDE_OPENAI_MODEL=gpt-4o-mini

# Ollama (local models; point at your Ollama server)
#CODEGUIDE_OLLAMA_BASE_URL=http://localhost:11434
#CODEGUIDE_OLLAMA_MODEL=llama3.1

# --- Database ----------------------------------------------------------------
# SQLite by default; docker-compose sets Postgres automatically.
#CODEGUIDE_DATABASE_URL=postgresql+asyncpg://codeguide:codeguide@db:5432/codeguide

# --- Sandbox -----------------------------------------------------------------
#CODEGUIDE_EXECUTION_BACKEND=docker        # docker | kubernetes | local
#CODEGUIDE_WORKER_CONCURRENCY=2
#CODEGUIDE_SANDBOX_WALL_TIMEOUT_S=120
#CODEGUIDE_SANDBOX_MEMORY_MB=512
